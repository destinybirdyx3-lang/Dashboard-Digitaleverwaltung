{
  "name": "mh-dashboard-web",
  "version": "0.1.0",
  "description": "Frontend des Digitalisierungs-Dashboards der Stadt Mülheim an der Ruhr",
  "scripts": {
    "dev": "vite",
    "dev:intern": "vite --mode intern",
    "build": "npm run typecheck && vite build --mode public && vite build --mode intern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview --mode public"
  },
  "license": "EUPL-1.2",
  "dependencies": {
    "@kern-ux/native": "2.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "private": true,
  "type": "module"
}
